# Copy this file to `.env` (same directory) for local development.
# `.env` is gitignored — see .gitignore — so this is safe to commit as
# a template.
#
# Base URL of the TerraMatch Spring Boot backend. Every API call in
# src/services/api.js reads this via import.meta.env.VITE_API_URL — it
# is never hardcoded elsewhere in the app.
VITE_API_URL=http://localhost:8082
